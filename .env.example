# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)

# AI provider: groq (default, hosted) or ollama (local; code stays on this machine).
# AI is off for every repository until you allow it in the app; secrets are
# redacted and sensitive files are never sent.
# CODELENS_LLM_PROVIDER=groq

# Groq API key. Create one at https://console.groq.com/keys
GROQ_API_KEY=
# CODELENS_GROQ_MODEL=openai/gpt-oss-120b

# Ollama (when CODELENS_LLM_PROVIDER=ollama). Run: ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# CODELENS_OLLAMA_MODEL=llama3.1

# Where imported repositories are stored. Relative paths are resolved
# against the project root. Default: <project root>/uploads
# CODELENS_UPLOAD_DIR=
